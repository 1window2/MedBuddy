GEMINI_API_KEY=place_your_gemini_api_key_here   # https://aistudio.google.com/api-keys
PUBLIC_DATA_API_KEY=place_your_public_data_api_key_here
APP_ENV=development
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=
FIREBASE_CHECK_REVOKED_TOKENS=false
FIREBASE_REQUIRE_VERIFIED_EMAIL=true
FIREBASE_ALLOW_PHONE_AUTH=false
FIREBASE_ALLOW_ANONYMOUS_AUTH=false
DATABASE_URL=sqlite:///./medbuddy.db
AUTO_CREATE_SCHEMA=true
BASIC_DRUG_API_BASE_URL=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService/getDrbEasyDrugList
ADVANCED_DRUG_API_BASE_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07/getDrugPrdtPrmsnDtlInq06
PILL_IMAGE_API_BASE_URL=https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03/getMdcinGrnIdntfcInfoList03
PILL_IMAGE_API_ENABLED=true
PILL_IMAGE_API_TIMEOUT_SECONDS=8
PILL_IDENTIFICATION_MODEL_NAME=gemini-3.1-flash-lite
PILL_IDENTIFICATION_TIMEOUT_SECONDS=20
PILL_IDENTIFICATION_CATALOG_TTL_HOURS=168
PILL_IDENTIFICATION_CATALOG_REFRESH_TIMEOUT_SECONDS=30
PRESCRIPTION_OCR_TIMEOUT_SECONDS=30
PRESCRIPTION_NAME_FALLBACK_TIMEOUT_SECONDS=8
MEDICATION_SUMMARY_TIMEOUT_SECONDS=20
HEALTH_RECOMMENDATION_TIMEOUT_SECONDS=20
