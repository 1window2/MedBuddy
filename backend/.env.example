GEMINI_API_KEY=place_your_gemini_api_key_here   # https://aistudio.google.com/api-keys
PUBLIC_DATA_API_KEY=place_your_public_data_api_key_here
APP_ENV=development
RUNTIME_ROLE=api
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=
FIREBASE_CHECK_REVOKED_TOKENS=false
FIREBASE_REQUIRE_VERIFIED_EMAIL=true
FIREBASE_ALLOW_PHONE_AUTH=false
FIREBASE_ALLOW_ANONYMOUS_AUTH=false
FIREBASE_APP_CHECK_REQUIRED=false
FIREBASE_OFF_PLAY_BETA_MODE=false
TRUSTED_HOSTS=api.medbuddy.pp.ua,localhost,127.0.0.1,backend
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS=300
DATABASE_URL=sqlite:///./medbuddy.db
AUTO_CREATE_SCHEMA=true
APPLICATION_TIME_ZONE=Asia/Seoul
BASIC_DRUG_API_BASE_URL=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService/getDrbEasyDrugList
ADVANCED_DRUG_API_BASE_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07/getDrugPrdtPrmsnDtlInq06
PILL_IMAGE_API_BASE_URL=https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03/getMdcinGrnIdntfcInfoList03
PHARMACY_API_BASE_URL=https://apis.data.go.kr/B552657/ErmctInsttInfoInqireService
PHARMACY_API_TIMEOUT_SECONDS=12
# Apply separately for NEMC hospital service and KASI Special Day Information.
# See README.md: Nearby Care API Credentials. Never commit actual local keys.
# Hospital key is optional; blank reuses PUBLIC_DATA_API_KEY.
# KASI holiday and pharmacy requests always use PUBLIC_DATA_API_KEY.
HOSPITAL_API_KEY=
HOSPITAL_API_BASE_URL=https://apis.data.go.kr/B552657/HsptlAsembySearchService
HOSPITAL_API_TIMEOUT_SECONDS=8
HOSPITAL_LOCATION_CACHE_SECONDS=300
HOSPITAL_DETAIL_CACHE_SECONDS=86400
HOSPITAL_CACHE_MAX_ENTRIES=512
HOSPITAL_SEARCH_MAX_PAGES=3
# Selected specialty: total list pages across discovered nearby regions (100 rows/page).
HOSPITAL_DEPARTMENT_MAX_PAGES=24
HOSPITAL_DETAIL_REQUEST_BUDGET=12
HOSPITAL_SEARCH_TIMEOUT_SECONDS=22
HOSPITAL_CALENDAR_TIMEOUT_SECONDS=2
# Per-process budget; restarts reset it and multiple workers have separate budgets.
HOSPITAL_API_DAILY_REQUEST_BUDGET=800
# Searches one account may run per day; one IP address is allowed twenty times this.
HOSPITAL_SEARCH_DAILY_LIMIT=120
PILL_IMAGE_API_ENABLED=true
PILL_IMAGE_API_TIMEOUT_SECONDS=8
PILL_IDENTIFICATION_MODEL_NAME=gemini-3.1-flash-lite
PILL_IDENTIFICATION_TIMEOUT_SECONDS=20
PILL_IDENTIFICATION_CATALOG_TTL_HOURS=168
PILL_IDENTIFICATION_CATALOG_REFRESH_TIMEOUT_SECONDS=30
# KPIC public dashboard product count as of 2026-09-02; review before releases.
PILL_IDENTIFICATION_KPIC_PRODUCT_FLOOR=24667
PILL_IDENTIFICATION_CATALOG_ALLOW_INLINE_REFRESH=true
PRESCRIPTION_OCR_TIMEOUT_SECONDS=30
PRESCRIPTION_NAME_FALLBACK_TIMEOUT_SECONDS=8
MEDICATION_SUMMARY_TIMEOUT_SECONDS=20
HEALTH_RECOMMENDATION_TIMEOUT_SECONDS=20
PUBLIC_API_MAX_CONCURRENCY=6
PUBLIC_API_FAILURE_CACHE_SECONDS=30
PERIODIC_MAINTENANCE_ENABLED=true
PERIODIC_MAINTENANCE_INTERVAL_SECONDS=21600
HEALTH_RECOMMENDATION_CACHE_RETENTION_DAYS=90
CAREGIVER_ALERT_OUTBOX_POLL_SECONDS=15
CAREGIVER_ALERT_OUTBOX_RETENTION_DAYS=30
# A caregiver missed-dose alert is never sent earlier than the patient's reminder time for the
# slot plus this many minutes, even when the caregiver's deadline is earlier.
CAREGIVER_MISSED_DOSE_GRACE_MINUTES=30
SAVED_MEDICATION_RETENTION_DAYS_AFTER_END=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUIRE_REDIS=false
REDIS_URL=redis://localhost:6379
CHAT_MESSAGE_DAILY_LIMIT=500
# Requests one account may send per day to the AI-backed routes (prescription analysis,
# pill identification, health recommendation, counted together). Twenty times this per IP.
AI_REQUEST_DAILY_LIMIT=300
CHAT_MESSAGE_RETENTION_DAYS=90
CHAT_PUSH_MIN_INTERVAL_SECONDS=10
CHAT_WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
CHAT_WEBSOCKET_CONNECTIONS_PER_MINUTE=12
CHAT_WEBSOCKET_IDLE_TIMEOUT_SECONDS=90
CHAT_WEBSOCKET_MIN_PING_INTERVAL_SECONDS=10
# Seconds between checks that an open chat stream still belongs to an active link.
CHAT_WEBSOCKET_REVALIDATION_INTERVAL_SECONDS=60
CHAT_WEBSOCKET_MAX_FRAME_BYTES=4096
