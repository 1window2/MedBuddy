<?xml version="1.0" encoding="utf-8"?>
<!-- 완료 기록 취소는 복용 버튼과 구분되는 윤곽선으로 표시한다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#E5EBE8" /><stroke android:width="1dp" android:color="#ACBDB5" /><corners android:radius="8dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#D0F5E5" /><stroke android:width="1dp" android:color="#007E5E" /><corners android:radius="8dp" /></shape></item>
    <item><shape><solid android:color="#F5FBF7" /><stroke android:width="1dp" android:color="#007E5E" /><corners android:radius="8dp" /></shape></item>
</selector>
