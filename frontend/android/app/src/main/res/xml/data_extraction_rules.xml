<?xml version="1.0" encoding="utf-8"?>
<!-- File Name: data_extraction_rules.xml
     Role: Exclude all app data from cloud backup and device-to-device transfer on Android 12+.
     The encrypted dose store is unreadable without its Keystore-bound key, which never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
