<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). The foreground holds only the mark, inside the
     66 dp safe zone of the 108 dp layer, so Samsung's squircle and Pixel's circle masks
     no longer crop it; the legacy mipmap-*/ic_launcher.png stays for Android 7 and older.
     The monochrome layer is used for Android 13 themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
