# MedBuddy Docker Compose host configuration.
# Copy this file to deploy/.env and keep the real file out of Git.

# The application builds its database URL from structured fields, so this raw
# password may contain URL-reserved characters such as @, :, /, ?, and #.
POSTGRES_PASSWORD=__REPLACE_ME__

MEDBUDDY_BACKEND_PORT=8000

# Full MFDS catalog refresh cadence and retry backoff for catalog-refresh.
CATALOG_REFRESH_INTERVAL_SECONDS=604800
CATALOG_REFRESH_RETRY_SECONDS=3600

# Optional: point Compose at the tracked template for configuration-only checks.
# Production should keep the default deploy/backend.env path.
# MEDBUDDY_BACKEND_ENV_FILE=./deploy/backend.env.example

FIREBASE_ADMIN_CREDENTIALS_PATH=/home/your-user/.config/medbuddy/secrets/firebase-admin.json
CLOUDFLARE_TUNNEL_TOKEN_FILE=/home/your-user/.config/medbuddy/secrets/cloudflare-tunnel-token
