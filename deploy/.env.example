# MedBuddy Docker Compose host configuration.
# Copy this file to deploy/.env and keep the real file out of Git.

POSTGRES_PASSWORD=__REPLACE_ME__

MEDBUDDY_BACKEND_PORT=8000

FIREBASE_ADMIN_CREDENTIALS_PATH=/home/your-user/.config/medbuddy/secrets/firebase-admin.json
CLOUDFLARE_TUNNEL_TOKEN_FILE=/home/your-user/.config/medbuddy/secrets/cloudflare-tunnel-token
