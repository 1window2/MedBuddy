@startuml
allowmixing
scale max 8192 width
left to right direction
!pragma layout smetana

title Authentication, Settings, and Accessibility - Key Classes

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Nanum Gothic
skinparam defaultFontSize 15
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

skinparam classBackgroundColor<<UI>> #E8F4FF
skinparam classBorderColor<<UI>> #147BC1
skinparam classBackgroundColor<<Control>> #EAF8F0
skinparam classBorderColor<<Control>> #159957
skinparam classBackgroundColor<<Service>> #F8FAFC
skinparam classBorderColor<<Service>> #64748B
skinparam classBackgroundColor<<Entity>> #F5F3FF
skinparam classBorderColor<<Entity>> #7C3AED
skinparam classBackgroundColor<<Database>> #FFF7E6
skinparam classBorderColor<<Database>> #D97706
skinparam classBackgroundColor<<External>> #FFF7E6
skinparam classBorderColor<<External>> #D97706

package "Flutter Frontend" #E8F4FF {
  class AuthenticationGate <<UI>>
  class AuthenticationUI <<UI>>
  class "AuthenticationControl" as FAuthenticationControl <<Control>>
  class FirebaseRuntimeService <<Service>>
  class ForegroundRecoveryService <<Service>>
  class AuthenticatedApiClient <<Service>>
  class ManageUserSettingUI <<UI>>
  class NotificationDeviceSettings <<UI>>
  class NotificationReadinessControl <<Control>>
  class NotificationReadinessSnapshot <<Entity>>
  class NotificationService <<Service>>
  class DataUseInfoUI <<UI>>
  class MedBuddyViewModel <<Control>>
  class MedBuddyUserSettingViewModel <<Control>>
  class "ManageUserSetting" as FManageUserSetting <<Control>>
  class ManageAccount <<Control>>
  database "SharedPreferences\naccount-scoped settings" as LocalSettings <<Database>>
  class AppLanguageControl <<Control>>
  class "RequestVoiceGuide" as FRequestVoiceGuide <<Control>>
  class TTSService <<Service>>
  class "UserSetting" as FUserSetting <<Entity>>
}

package "FastAPI Backend" #EAF8F0 {
  class OIDCTokenVerifier <<Service>>
  class AppCheckTokenVerifier <<Service>>
  class ApiContractMiddleware <<Service>>
  class AccountOperationLocks <<Service>>
  note "api/dependencies.py module functions\nApp Check 및 ID Token 검증\nauth freshness, account lock, registration" as BAccountDependencies
  class "AuthorizationControl" as BAuthorizationControl <<Control>>
  class "ManageUserSetting" as BManageUserSetting <<Control>>
  class "RequestVoiceGuide" as BRequestVoiceGuide <<Control>>
  database "user_accounts" as DBUserAccount <<Database>>
  database "user_settings" as DBUserSetting <<Database>>
}

cloud "Firebase Authentication" as FirebaseAuth
cloud "Firebase App Check" as FirebaseAppCheck

AuthenticationGate --> AuthenticationUI
AuthenticationUI --> FAuthenticationControl
AuthenticationUI *-- ForegroundRecoveryService : 전경 Session 복구 callback
FAuthenticationControl --> FirebaseRuntimeService
FAuthenticationControl --> FirebaseAuth : sign-in and session state
FirebaseRuntimeService --> FirebaseAuth
FirebaseRuntimeService --> FirebaseAppCheck
note bottom of FirebaseRuntimeService
  Firebase 인증과 App Check는 조건을 분리한다.
  명시적 off-Play beta는 ID Token 인증을 유지하고
  App Check만 생략한다. Phone/SMS는 dormant 상태다.
end note
note bottom of ForegroundRecoveryService
  일시적 실패만 복구하며 권한 오류를 우회하지 않는다.
  복약 변경 요청은 자동 재실행하지 않는다.
end note
FAuthenticationControl --> AuthenticatedApiClient
AppCheckTokenVerifier --> FirebaseAppCheck : Firebase Admin verification
BAccountDependencies --> OIDCTokenVerifier : ID token verification
BAccountDependencies --> AppCheckTokenVerifier : App Check verification
BAccountDependencies --> BAuthorizationControl
BAccountDependencies --> AccountOperationLocks : SQLite request-lifetime scope
note bottom of AccountOperationLocks
  Owns holder/waiter references and cancellation-safe cleanup.
  Inline timed acquisition preserves cancellation during ownership handoff.
  Idle account identities are removed; locks are process-local.
  PostgreSQL retains its transaction-scoped advisory locks.
end note
BAuthorizationControl --> DBUserAccount

ManageUserSettingUI --> MedBuddyViewModel : 주입된 설정 저장 callback
MedBuddyViewModel *-- MedBuddyUserSettingViewModel
MedBuddyUserSettingViewModel --> FManageUserSetting
note bottom of MedBuddyUserSettingViewModel
  설정 조회·수동 저장·기기 언어 동기화를 같은 순서로 처리한다.
  종료된 계정의 늦은 응답은 다른 계정에 반영하지 않는다.
end note
ManageUserSettingUI *-- NotificationDeviceSettings : 복약 및 알림 안에 통합
ManageUserSettingUI --> DataUseInfoUI : Account / Privacy & Data
NotificationDeviceSettings --> NotificationReadinessControl
NotificationReadinessControl --> NotificationReadinessSnapshot
NotificationReadinessControl --> NotificationService : 상태 조회 / 시스템 설정 / 테스트
note bottom of NotificationReadinessControl
  약 등록 점검·독립 준비 화면은 제거하고 기기 권한·테스트만 제공한다.
  겹친 점검을 합치며 실패·미지원 항목은 성공으로 표시하지 않는다.
  알림·복약 channel·정확한 알람 권한을 분리하고 자동 요청하지 않는다.
  테스트 요청과 사용자의 실제 수신 확인을 구분한다.
  테스트 알림에는 복약 action·화면 payload·알림함 기록이 없다.
  정확한 알람 설정 지원 여부를 분리하고 복귀 후 허용 상태로 재예약한다.
end note
note bottom of NotificationDeviceSettings
  Android의 알림 허용·정확한 시간 스위치는 운영체제 설정을 연다.
  앱에서 직접 권한을 요청하거나 표시값을 미리 바꾸지 않는다.
  resumed 복귀 시 실제 권한 상태를 다시 읽어 표시한다.
  복약 channel이 꺼져 있으면 알림 허용 스위치도 꺼짐으로 표시한다.
end note
note bottom of FAuthenticationControl
  main.dart의 세션 종료 준비 callback은 Push 해제를 먼저 수행한다.
  준비 중 실패하면 같은 세션·세대에서만 저장소·위젯·알림·작업·Push를 복구한다.
  한 단계 실패 후에도 나머지를 시도하며 다른 계정 세션에는 복원하지 않는다.
  세부 흐름은 OverallSystemSequenceDiagram.puml의 1A를 따른다.
end note
note bottom of DataUseInfoUI
  실제 데이터 흐름·외부 AI·공유·캐시·삭제 범위를 설명한다.
  확정 개인정보처리방침, AI 동의 수집 또는 전송 차단 기능은 아니다.
end note
ManageUserSettingUI --> AppLanguageControl
FManageUserSetting --> BManageUserSetting : GET revision / PUT expected_revision
FManageUserSetting --> LocalSettings : atomic JSON snapshot; then legacy mirrors
ManageAccount --> LocalSettings : exact-owner cleanup after server deletion
note bottom of ManageAccount
  서버 계정 삭제 확인 뒤 이전 빌드가 남겼을 수 있는 기록 내보내기 임시 cache도
  clearExports로 정리한다(현재 외부 공유는 파일을 만들지 않는다).
  외부 앱이나 상대방이 저장한 사본은 회수하지 못한다.
end note
BManageUserSetting --> DBUserSetting : expected revision + ORM version guard
BManageUserSetting --> FUserSetting : persisted preferences
note bottom of FManageUserSetting
  같은 isolate의 계정별 잠금으로 읽기·검사·저장을 직렬화한다.
  HTTP 대기는 잠금 밖에서 수행하며 다른 계정은 기다리지 않는다.
  최신 pending token만 ACK를 반영하거나 409 후 재시도한다.
  전송은 최대 3회 시도하며 늦은 GET은 의도·버전을 재검사한다.
  백그라운드는 로컬 조회 전용이며 원격 쓰기 isolate 간 잠금은 아니다.
end note
note bottom of LocalSettings
  user_setting_<owner>_snapshot이 우선하는 단일 JSON이다.
  setting, pending_sync, latest_intent, server_revision을 함께 저장한다.
  유효한 snapshot이 없을 때만 기존 개별 키로 복원한다.
  계정 삭제는 snapshot과 동기화 메타데이터도 정리하되
  다른 계정의 키와 삭제 실패 시 로컬 상태를 보존한다.
end note
note bottom of BManageUserSetting
  늦은 PUT은 409 settings_revision_conflict와 현재 버전으로 거절한다.
  ORM 버전 검사로 조회 이후의 동시 저장도 감지한다.
  값이 같아도 버전을 올리며 저장 전 기본값의 버전은 0이다.
  expected_revision 없는 구형 요청도 허용하지만 지연 덮어쓰기는 막지 못한다.
end note
note bottom of FUserSetting
  알림 종류별 허용·공개 범위, 언어·시간 형식,
  신규 일정 기본 시각과 홈 조회 대상을 저장한다.
  medicationSearchMode(fast·balanced·thorough)는 기기 전용 값이며
  이것만 바꾸면 서버 동기화·revision을 건드리지 않는다.
end note

ManageUserSettingUI --> TTSService : 기기 내 음성 미리듣기
FRequestVoiceGuide --> BRequestVoiceGuide : guide text API
FRequestVoiceGuide --> TTSService : on-device speech
@enduml
