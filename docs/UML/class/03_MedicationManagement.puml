@startuml
allowmixing
scale max 1920 width
left to right direction
!pragma layout smetana

title Medication Management - Key Classes

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

skinparam classBackgroundColor<<UI>> #E8F4FF
skinparam classBorderColor<<UI>> #147BC1
skinparam classBackgroundColor<<Control>> #EAF8F0
skinparam classBorderColor<<Control>> #159957
skinparam classBackgroundColor<<Service>> #F8FAFC
skinparam classBorderColor<<Service>> #64748B
skinparam classBackgroundColor<<Entity>> #F5F3FF
skinparam classBorderColor<<Entity>> #7C3AED
skinparam classBackgroundColor<<Database>> #FFF7E6
skinparam classBorderColor<<Database>> #D97706
skinparam classBackgroundColor<<External>> #FFF7E6
skinparam classBorderColor<<External>> #D97706

package "Flutter Frontend" #E8F4FF {
  class CheckScheduleUI <<UI>>
  class CheckSavedMedicationUI <<UI>>
  class CheckMedicationDetailUI <<UI>>
  class MedBuddyViewModel <<Control>>
  class MedBuddyScheduleViewModel <<Control>>
  class MedBuddySavedMedicationViewModel <<Control>>
  class MedBuddyReminderViewModel <<Control>>
  class DoseSyncService <<Service>>
  class NotificationService <<Service>>
  class ManualMedicationImageStore <<Service>>
  class "CheckSchedule" as FCheckSchedule <<Control>>
  class "CheckSavedMedication" as FCheckSavedMedication <<Control>>
  class "CheckMedicationDetail" as FCheckMedicationDetail <<Control>>
  class "MedicationSchedule" as FMedicationSchedule <<Entity>>
  class "MedicationDetail" as FMedicationDetail <<Entity>>
}

package "FastAPI Backend" #EAF8F0 {
  class "CheckSchedule" as BCheckSchedule <<Control>>
  class "CheckSavedMedication" as BCheckSavedMedication <<Control>>
  class "CheckMedicationDetail" as BCheckMedicationDetail <<Control>>
  class MedicationCoursePolicy <<Service>>
  class SavedMedicationRetentionPolicy <<Service>>
  class SavedMedicationRepository <<Service>>
  class "_LocalMedicationCatalog" as LocalMedicationCatalog <<Service>>
  database "saved_medications" as DBSavedMedication <<Database>>
  database "medication_completions" as DBMedicationCompletion <<Database>>
}

cloud "MFDS Drug APIs" as MFDS

CheckScheduleUI --> MedBuddyViewModel
CheckSavedMedicationUI --> MedBuddyViewModel
CheckMedicationDetailUI --> MedBuddyViewModel
MedBuddyViewModel *-- MedBuddyScheduleViewModel
MedBuddyViewModel *-- MedBuddySavedMedicationViewModel
MedBuddyViewModel *-- MedBuddyReminderViewModel
MedBuddyScheduleViewModel --> FCheckSchedule
MedBuddyScheduleViewModel --> DoseSyncService : 기기 선저장·멱등 전송
MedBuddySavedMedicationViewModel --> FCheckSavedMedication
MedBuddyViewModel --> FCheckMedicationDetail
MedBuddyReminderViewModel --> NotificationService : 알림 계획 조정
MedBuddySavedMedicationViewModel --> ManualMedicationImageStore : 기기 사진 저장

note bottom of MedBuddyViewModel
  일정 탭 재방문은 같은 날의 성공한 조회를 15초 미만 재사용한다.
  명시적 새로고침은 재조회하며 상태 변경은 캐시를 무효화한다.
  진행 중인 일정·알림 설정 조회는 합친다.
end note
note bottom of NotificationService
  날짜별 계획과 기기 예약을 비교하여 변경분만 갱신한다.
  동일 예약과 미루기를 보존하고 예약·미루기·취소를 직렬화한다.
end note
note bottom of ManualMedicationImageStore
  사진 축소·압축은 별도 isolate에서 처리한다.
  목록 썸네일은 표시 크기에 맞춰 디코딩 크기를 제한한다.
end note

FCheckSchedule --> BCheckSchedule : schedule API
FCheckSavedMedication --> BCheckSavedMedication : saved medication API
FCheckMedicationDetail --> BCheckMedicationDetail : detail API

BCheckSchedule --> MedicationCoursePolicy
BCheckSchedule --> SavedMedicationRetentionPolicy
BCheckSchedule --> SavedMedicationRepository
BCheckSchedule --> DBSavedMedication
BCheckSchedule --> DBMedicationCompletion

note bottom of BCheckSchedule
  개별 약과 시간대 전체 완료·취소를 처리한다.
  홈·알림은 전체 완료 후 일정 확인으로 연결한다.
  알림의 대상 날짜를 검사하고 신규 시간대 완료는
  같은 Transaction에 보호자 Outbox로 기록한다.
end note

BCheckSavedMedication --> MedicationCoursePolicy
BCheckSavedMedication --> SavedMedicationRetentionPolicy
BCheckSavedMedication --> SavedMedicationRepository
BCheckSavedMedication --> DBSavedMedication

BCheckMedicationDetail --> LocalMedicationCatalog
BCheckMedicationDetail --> MFDS

BCheckSchedule --> FMedicationSchedule : daily schedule
BCheckMedicationDetail --> FMedicationDetail : medication detail
@enduml
