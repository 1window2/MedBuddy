@startuml
allowmixing
scale max 8192 width
left to right direction
!pragma layout smetana

title Medication Management - Key Classes

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Nanum Gothic
skinparam defaultFontSize 15
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

skinparam classBackgroundColor<<UI>> #E8F4FF
skinparam classBorderColor<<UI>> #147BC1
skinparam classBackgroundColor<<Control>> #EAF8F0
skinparam classBorderColor<<Control>> #159957
skinparam classBackgroundColor<<Service>> #F8FAFC
skinparam classBorderColor<<Service>> #64748B
skinparam classBackgroundColor<<Entity>> #F5F3FF
skinparam classBorderColor<<Entity>> #7C3AED
skinparam classBackgroundColor<<Database>> #FFF7E6
skinparam classBorderColor<<Database>> #D97706
skinparam classBackgroundColor<<External>> #FFF7E6
skinparam classBorderColor<<External>> #D97706

package "Flutter Frontend" #E8F4FF {
  class CheckScheduleUI <<UI>>
  class CheckSavedMedicationUI <<UI>>
  class CheckMedicationDetailUI <<UI>>
  class MedicationRegimenEditorUI <<UI>>
  class MedicationHistoryUI <<UI>>
  class MedicationHistoryMonthCalendar <<UI>>
  class AsNeededScheduleSection <<UI>>
  class MedicationHistoryControl <<Control>>
  class AsNeededPendingStore <<Service>>
  class DoseOutboxStore <<Service>>
  note "dose_history_pending_store.dart\nDoseHistoryPendingStore extension\n독립 객체가 아닌 암호화 저장소 확장" as HistoryPending
  class AsNeededCheckReminderControl <<Control>>
  class MedicationHistorySnapshot <<Entity>>
  class MedicationHistoryChange <<Entity>>
  class MedBuddyViewModel <<Control>>
  class MedBuddyScheduleViewModel <<Control>>
  class MedBuddySavedMedicationViewModel <<Control>>
  class MedBuddyReminderViewModel <<Control>>
  class DoseSyncService <<Service>>
  class NotificationService <<Service>>
  class MedicationReminderRefreshFactory <<Service>>
  class MedicationReminderRefreshService <<Service>>
  class MedicationNotificationPayloadCodec <<Service>>
  class MedicationNotificationSelection <<Entity>>
  class ManualMedicationImageStore <<Service>>
  class "CheckSchedule" as FCheckSchedule <<Control>>
  class "CheckSavedMedication" as FCheckSavedMedication <<Control>>
  class "CheckMedicationDetail" as FCheckMedicationDetail <<Control>>
  class "MedicationSchedule" as FMedicationSchedule <<Entity>>
  class "MedicationDetail" as FMedicationDetail <<Entity>>
  class "DoseCycle" as FDoseCycle <<Entity>>
}

package "FastAPI Backend" #EAF8F0 {
  class ManageMedicationCare <<Control>>
  class AuthorizationControl <<Control>>
  note "medication_care_recording.py\napply_completion_report()" as ReportRecording
  note "medication_care_receipts.py\nredact_medication_care_receipts()" as ReceiptRedaction
  class "CheckSchedule" as BCheckSchedule <<Control>>
  class "CheckSavedMedication" as BCheckSavedMedication <<Control>>
  class "CheckMedicationDetail" as BCheckMedicationDetail <<Control>>
  class MedicationCoursePolicy <<Service>>
  class SavedMedicationRetentionPolicy <<Service>>
  class SavedMedicationRepository <<Service>>
  class LocalMedicationCatalog <<Service>>
  class MedicationTextNormalizer <<Service>>
  class MedicationNameMatcher <<Service>>
  class MedicationDetailCache <<Boundary>>
  class MedicationSummaryGenerator <<Boundary>>
  class MedicationLookupResult <<Entity>> {
    + details : list<MedicationDetail>
    + is_complete : bool
  }
  database "saved_medications" as DBSavedMedication <<Database>>
  database "medication_completions" as DBMedicationCompletion <<Database>>
  database "medication_care_audits\nmedication_care_operations" as DBCareMetadata <<Database>>
}

cloud "MFDS Drug APIs" as MFDS
boundary "Android ACTION_SEND\ntext/plain" as ExportProvider

CheckScheduleUI --> MedBuddyViewModel
CheckSavedMedicationUI --> MedBuddyViewModel
CheckSavedMedicationUI --> MedicationRegimenEditorUI : confirmed change
note top of CheckSavedMedicationUI
  저장 약을 등록일 또는 복용일 기준 날짜별 접이식 카드로 묶는다.
  검색 중에는 접힘 상태를 따로 관리한다.
end note
MedicationRegimenEditorUI --> MedBuddyViewModel : onSubmit callback
CheckScheduleUI --> MedicationHistoryUI : calendar icon; month first
MedicationHistoryUI *-- MedicationHistoryMonthCalendar : visibleRange(month, today)
CheckScheduleUI *-- AsNeededScheduleSection
MedBuddyViewModel *-- MedicationHistoryControl : asNeededHistory / login session
MedicationHistoryUI --> MedicationHistoryControl : screen-owned history control
AsNeededScheduleSection --> MedicationHistoryControl : borrowed patient / owned read-only scope
MedicationHistoryControl --> MedicationHistorySnapshot
MedicationHistoryControl --> MedicationHistoryChange : stable event + operation UUID
MedicationHistoryControl --> AsNeededPendingStore : 새 필요시 요청 선저장·복원·ACK 제거
AsNeededPendingStore --> DoseOutboxStore
HistoryPending ..> DoseOutboxStore : 계정별 미확정 요청; 정기 큐와 분리
AsNeededScheduleSection --> AsNeededCheckReminderControl : patient only
AsNeededCheckReminderControl --> NotificationService : one future check; default off
MedicationHistoryUI --> ExportProvider : 확인한 기간의 자연어 텍스트 (파일 없음)
CheckMedicationDetailUI --> MedBuddyViewModel
MedBuddyViewModel *-- MedBuddyScheduleViewModel
MedBuddyViewModel *-- MedBuddySavedMedicationViewModel
MedBuddyViewModel *-- MedBuddyReminderViewModel
MedBuddyScheduleViewModel --> FCheckSchedule
MedBuddyScheduleViewModel --> DoseSyncService : 기기 선저장·멱등 전송
MedBuddySavedMedicationViewModel --> FCheckSavedMedication
MedBuddySavedMedicationViewModel --> DoseSyncService : 변경·삭제 전후 일정 무효화 callback
MedBuddyViewModel --> FCheckMedicationDetail
MedBuddyReminderViewModel --> NotificationService : 알림 계획 조정
MedicationReminderRefreshFactory --> MedicationReminderRefreshService : 읽기 함수 조립
MedicationReminderRefreshFactory --> DoseSyncService : 당일 영속 대기 기록을 겹친 일정 + 14일 기간 창 갱신
MedicationReminderRefreshService --> NotificationService : 복용일별 예약 보충
FMedicationDetail --> FDoseCycle : 다음 복용일 안내
note bottom of MedicationReminderRefreshService
  복용 기간과 주기에 맞는 날에만 예약한다.
  오늘 복용 완료와 미전송 기록은 Factory가 조립한 일정에 반영된다.
  불안정한 조회는 기존 예약을 유지하고 재시도한다.
  오늘 복용일이 아니어도 기존 알림 설정을 끄지 않는다.
end note
NotificationService --> MedicationNotificationPayloadCodec : shared wire validation
MedicationNotificationPayloadCodec --> MedicationNotificationSelection
note bottom of MedicationNotificationPayloadCodec
  Platform-independent payload and action protocol.
  Original dose dates and legacy navigation semantics stay unchanged.
  Scheduling and plugin lifecycle remain in NotificationService.
end note
MedBuddySavedMedicationViewModel --> ManualMedicationImageStore : 기기 사진 저장

note bottom of MedBuddyViewModel
  일정 탭 재방문은 같은 날의 성공한 조회를 15초 미만 재사용한다.
  명시적 새로고침은 재조회하며 상태 변경은 캐시를 무효화한다.
  진행 중인 일정·알림 설정 조회는 합친다.
end note
note bottom of NotificationService
  날짜별 계획과 기기 예약을 비교하여 변경분만 갱신한다.
  동일 예약과 미루기를 보존하고 예약·미루기·취소를 직렬화한다.
end note
note bottom of ManualMedicationImageStore
  사진 축소·압축은 별도 isolate에서 처리한다.
  목록 썸네일은 표시 크기에 맞춰 디코딩 크기를 제한한다.
end note

FCheckSchedule --> BCheckSchedule : schedule API
FCheckSavedMedication --> BCheckSavedMedication : saved medication API
FCheckSavedMedication --> ManageMedicationCare : POST regimen change
MedicationHistoryControl --> ManageMedicationCare : GET history / patient-only PUT
ManageMedicationCare --> AuthorizationControl : owner / active linked reader
ManageMedicationCare --> MedicationCoursePolicy
ManageMedicationCare --> BCheckSavedMedication : snapshot adapter
ManageMedicationCare --> DBSavedMedication : versioned edit / stop / replace
ManageMedicationCare --> DBMedicationCompletion : current reports / due slots
ManageMedicationCare --> DBCareMetadata : atomic audit + operation receipt
ManageMedicationCare --> ReportRecording
BCheckSchedule --> ReportRecording : existing completion / undo paths
ReportRecording --> DBMedicationCompletion
ReportRecording --> DBCareMetadata : before / after audit
note bottom of ManageMedicationCare
  Old regimen and reports survive a new effective snapshot.
  Same operation replays; changed content/revision conflicts.
  History: at most 31 days within the last 90 Korea dates.
  PRN uses as_needed:<UUID>, never automatic scheduled slots.
  Today's new PRN taken transition queues a caregiver event
  in the same transaction (see caregiver class diagram).
end note
note bottom of MedicationHistoryMonthCalendar
  보이는 달의 조회 가능 범위를 readRange()로 한 번 읽는다(서버 변경 없음).
  날짜별 정기 복용 기록 수(예: 2/3)와 전부·일부·없음 색, 필요시 기록 링을 표시한다.
  90일 이전 달과 오늘 이후 날짜는 선택할 수 없고 날짜를 누르면 기존 하루 화면을 연다.
  보호자는 같은 달력을 읽기 전용으로 본다.
end note
note bottom of AsNeededScheduleSection
  저장 안내의 실행 취소는 이번 동작으로 만든 필요시 기록만 '미기록'으로 되돌린다.
  일정 화면을 떠난 뒤에도 공유 기록 Control로 동작하며 보낸 보호자 알림은 회수하지 않는다.
  지난날 미확정 기록을 다시 보낸 경우에는 실행 취소 대신 다시 누르도록 안내한다.
end note
note bottom of MedicationHistoryControl
  Session change clears data, open edits and export access.
  readRangeForExport(): 외부 공유는 최대 90일을 31일 단위로 나눠 읽어 합친다.
  서버 ACK 뒤에만 저장 성공으로 표시한다.
  새 PRN 의도는 이벤트·작업 UUID와 확정 시각을 기기에 보존한다.
  재시작 후 같은 계정에서 먼저 복원하며 새 의도로 덮지 않는다.
  기존 기록 정정은 영속 큐가 아니며 PRN 대기는 자동 background 전송하지 않는다.
end note
note bottom of ExportProvider
  날짜별 약·복용 기록과 선택 기간의 요약만 텍스트로 만든다.
  내부 식별값·revision·무관한 약은 제외한다.
  100,000자 초과는 기간 축소를 요청하며 기록을 잘라내지 않는다.
  공유 창 열림은 전달 완료가 아니며 미지원 기기는 별도 동의 후 복사한다.
end note
FCheckMedicationDetail --> BCheckMedicationDetail : detail API

BCheckSchedule --> MedicationCoursePolicy
BCheckSchedule --> SavedMedicationRepository
BCheckSchedule --> DBSavedMedication
BCheckSchedule --> DBMedicationCompletion

note bottom of BCheckSchedule
  개별 약과 시간대 전체 완료·취소를 처리한다.
  홈·알림은 전체 완료 후 일정 확인으로 연결한다.
  알림의 대상 날짜를 검사하고 신규 시간대 완료는
  같은 Transaction에 보호자 Outbox로 기록한다.
end note

BCheckSavedMedication --> MedicationCoursePolicy
BCheckSavedMedication --> SavedMedicationRetentionPolicy
BCheckSavedMedication --> SavedMedicationRepository
BCheckSavedMedication --> DBSavedMedication
BCheckSavedMedication --> ReceiptRedaction : 약 잠금 후 명시적 삭제
SavedMedicationRetentionPolicy --> ReceiptRedaction : 만료 재검사 후 삭제
ReceiptRedaction --> DBCareMetadata : 원본·교체 약 영수증 응답 비우기
note bottom of ReceiptRedaction
  삭제와 같은 트랜잭션에서 응답 JSON·약 참조를 비운다.
  요청 ID·서명·비식별화 표식만 남겨 재생성을 막는다.
  같은 요청 재전송은 410이며 삭제 전 건강정보를 반환하지 않는다.
end note
note bottom of BCheckSavedMedication
  새 약은 계정 저장 한도를 검사한다. 중복 약은 기존 ID를 반환한다.
  직접 등록·낱알 일정 검토도 복용 주기와 시간대를 보존한다.
  한 저장 요청의 만료 정리와 신규 저장·한도 검사는 같은 트랜잭션이다.
  저장 실패는 정리도 롤백하며 사전 중복 확인 응답은 정리를 커밋한다.
end note

BCheckMedicationDetail --> LocalMedicationCatalog
BCheckMedicationDetail --> MedicationTextNormalizer
BCheckMedicationDetail --> MedicationNameMatcher
BCheckMedicationDetail --> MedicationDetailCache
BCheckMedicationDetail --> MedicationSummaryGenerator
BCheckMedicationDetail ..> MedicationLookupResult : checks completeness before auto-selection
LocalMedicationCatalog ..> MedicationLookupResult : returns successful details + completeness
MedicationDetailCache ..> MedicationLookupResult : accepts only complete results
LocalMedicationCatalog --> MedicationNameMatcher
LocalMedicationCatalog --> MedicationSummaryGenerator
MedicationNameMatcher --> MedicationTextNormalizer
note bottom of LocalMedicationCatalog
  Workers own read/write sessions; request transactions are never committed.
  Summary writes compare the original product/document snapshot atomically.
  Refresh/deletion races do not attach old guidance to a changed catalog row.
  Optional caching failure does not hide generated details.
  Connection-local in-memory SQLite skips summary persistence.
end note
note right of MedicationLookupResult
  Partial AI failure keeps successful summaries.
  Incomplete results require explicit product confirmation,
  even when only one exact-name candidate remains.
  Completeness survives ranking, enrichment and fallback.
  All candidate summaries failing is a lookup error.
  This internal value does not change the API schema.
end note
note bottom of MedicationDetailCache
  Only nonempty, complete lookup results are cached for 7 days.
  Partial lists are retried on the next lookup.
  drug_info:v2: bypasses potentially partial legacy entries.
  An unreadable candidate invalidates the whole cache entry.
end note
BCheckMedicationDetail --> MFDS
note bottom of MedicationNameMatcher
  search_mode(fast·balanced·thorough)는 기기 설정값을 /identify 요청에 담는다.
  검색어는 각각 최대 2·4·8개이다. fast·balanced는 후보가 나오면 멈추고
  thorough는 완결된 단일 정확 일치가 나올 때까지 다음 검색어도 조회한다.
  모든 방식에서 원문 함량·제형 안전 검사를 유지한다.
end note

BCheckSchedule --> FMedicationSchedule : daily schedule
BCheckMedicationDetail --> FMedicationDetail : medication detail
@enduml
