@startuml
allowmixing
scale max 8192 width
left to right direction
!pragma layout smetana

title Patient-Caregiver Link and Notifications - Key Classes

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Malgun Gothic
skinparam defaultFontSize 15
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

skinparam classBackgroundColor<<UI>> #E8F4FF
skinparam classBorderColor<<UI>> #147BC1
skinparam classBackgroundColor<<Control>> #EAF8F0
skinparam classBorderColor<<Control>> #159957
skinparam classBackgroundColor<<Service>> #F8FAFC
skinparam classBorderColor<<Service>> #64748B
skinparam classBackgroundColor<<Database>> #FFF7E6
skinparam classBorderColor<<Database>> #D97706
skinparam classBackgroundColor<<External>> #FFF7E6
skinparam classBorderColor<<External>> #D97706

package "Flutter Frontend" #E8F4FF {
  class HomeScreen <<UI>>
  class ChatListUI <<UI>>
  class LinkedChatUI <<UI>>
  class LinkedChatHistoryViewModel <<Control>>
  class LinkedChatComposerViewModel <<Control>>
  class LinkedChatDoseRecorder <<Control>>
  class DoseSyncService <<Service>>
  class ChatMessageDraft <<Entity>>
  interface LinkedChatSessionTransport
  class LinkedChatRealtimeService <<Service>>
  class LinkedChatEntryUI <<UI>>
  class ChatUnreadSummary <<Entity>>
  class ManageChatList <<Control>>
  class ManageLinkedChat <<Control>>
  class LinkPatientCaregiverUI <<UI>>
  class CheckCaregiverMedicationUI <<UI>>
  class AsNeededScheduleSection <<UI>>
  class MedicationHistoryUI <<UI>>
  class SetCaregiverNotificationUI <<UI>>
  class CaregiverNotificationMonitorService <<Service>>
  class "LinkPatientCaregiver" as FLinkPatientCaregiver <<Control>>
  class ManageCaregiverPatientLocalState <<Control>>
  class "CheckCaregiverMedication" as FCheckCaregiverMedication <<Control>>
  class "SetCaregiverNotification" as FSetCaregiverNotification <<Control>>
  class CaregiverPatientLocalStateService <<Service>>
  class PushNotificationService <<Service>>
  class NotificationService <<Service>>
  class NotificationInboxUI <<UI>>
  class ManageNotificationInbox <<Control>>
  class NotificationInboxStore <<Service>>
  class NotificationInboxEntry <<Entity>>
  class CaregiverAlertActionControl <<Control>>
  class CaregiverAlertDeliveryService <<Service>>
  class CaregiverAlertContext <<Entity>>
}

package "FastAPI Backend" #EAF8F0 {
  class "LinkPatientCaregiver" as BLinkPatientCaregiver <<Control>>
  class "CheckCaregiverMedication" as BCheckCaregiverMedication <<Control>>
  class "CheckSchedule" as BCheckSchedule <<Control>>
  class ManageMedicationCare <<Control>>
  class CheckCaregiverMonitoring <<Control>>
  class "SetCaregiverNotification" as BSetCaregiverNotification <<Control>>
  note "as_needed_caregiver_events.py\nstable report keys / atomic event queue" as AsNeededEvents
  class "ManageLinkedChat" as BManageLinkedChat <<Control>>
  class QueueMissedDoseAlerts <<Control>>
  class DispatchCaregiverAlert <<Control>>
  class ProcessCaregiverAlertOutbox <<Control>>
  class CaregiverAlertOutboxWorker <<Service>>
  class ManageCaregiverAlert <<Control>>
  class ProcessChatNotifications <<Control>>
  class ChatNotificationWorker <<Service>>
  class DispatchChatMessageAlert <<Control>>
  class ChatConnectionManager <<Service>>
  database "chat_messages" as DBChatMessage <<Database>>
  database "chat_notification_jobs" as DBChatNotificationJob <<Database>>
  class PatientCaregiverLinkRepository <<Service>>
  database "patient_caregiver_links" as DBPatientCaregiverLink <<Database>>
  database "guardian_alert_settings" as DBCaregiverNotification <<Database>>
  database "caregiver_alert_outbox" as DBCaregiverAlertOutbox <<Database>>
  database "device_push_tokens" as DBDevicePushToken <<Database>>
}

cloud "Firebase Cloud Messaging" as FCM

LinkPatientCaregiverUI --> FLinkPatientCaregiver
HomeScreen --> ManageChatList : active connections
HomeScreen --> NotificationInboxUI : bell / unread badge
HomeScreen --> ManageNotificationInbox : lifecycle / unread count
NotificationInboxUI --> ManageNotificationInbox : list / read / delete
ManageNotificationInbox --> NotificationInboxStore : per-account local history
ManageNotificationInbox --> ManageChatList : current peer names
NotificationInboxStore --> NotificationInboxEntry
NotificationService --> NotificationInboxStore : local alerts / reminder events
PushNotificationService --> NotificationInboxStore : recipient-scoped push
NotificationInboxUI --> NotificationService : existing navigation handler
HomeScreen --> ChatListUI : conditional chat tab
ChatListUI --> LinkedChatUI : selected conversation
ChatListUI --> ManageChatList
ManageChatList --> FLinkPatientCaregiver
ManageChatList --> ManageCaregiverPatientLocalState
ManageChatList --> ManageLinkedChat : latest messages / unread summary
LinkedChatEntryUI --> ManageChatList : verify active link and role
LinkedChatEntryUI --> LinkedChatUI : patient hash / peer / current settings
ManageLinkedChat --> ChatUnreadSummary
LinkedChatUI --> ManageLinkedChat
LinkedChatUI *-- LinkedChatHistoryViewModel : account/link/patient session
LinkedChatUI *-- LinkedChatComposerViewModel : same identity-keyed session
LinkedChatUI *-- LinkedChatDoseRecorder : 선택 약·날짜·시간대 검증
LinkedChatDoseRecorder --> DoseSyncService : 계정별 영속 복용 기록
LinkedChatDoseRecorder --> ManageLinkedChat : 문맥 조회 / 큐 없는 경우의 fallback
LinkedChatComposerViewModel --> ManageLinkedChat : borrowed authenticated send adapter
LinkedChatComposerViewModel --> ChatMessageDraft : immutable payload / retry comparison
LinkedChatHistoryViewModel --> ManageLinkedChat : borrowed authenticated control
LinkedChatHistoryViewModel --> LinkedChatSessionTransport : borrowed lifecycle contract
LinkedChatRealtimeService ..|> LinkedChatSessionTransport
note bottom of LinkedChatHistoryViewModel
  Owns history recovery, backwards pagination, read/deletion evidence
  and failure-only polling; publishes immutable snapshots.
  UI supplies visibility/latest-position predicates and owns the draft.
  Late/disposed or wrong-link responses cannot update another session.
  이력 조회에서 연결 해제·권한 상실을 확인하면 반복 조회와 연결을 멈춘다.
  UI는 입력창 대신 연동 해제 안내를 표시하며 실패한 전송 후에도 한 번 확인한다.
end note
note bottom of LinkedChatRealtimeService
  chat-close-codes를 선언한 Client는 거절 사유를 종료 코드로 받는다.
  인증 갱신·접속 한도 대기·연결 중단을 구분한다.
  구형 Client는 승인 전 HTTP 거절을 유지한다.
end note
note bottom of LinkedChatComposerViewModel
  Serializes outgoing sends and retains failed payload/request identity.
  Attachment comparison is order-independent; primary wire order is preserved.
  UI keeps text fields, attachments, navigation and care retry display metadata.
  Dose recording keeps its separate operation identities.
  Disposed completions cannot clear or publish another session's draft.
end note
note top of LinkedChatUI
  입력 변경은 StatefulBuilder의 입력 행만 갱신한다.
  기존 메시지 목록과 말풍선의 입력별 재구성을 피한다.
  실시간 연결과 이력 조회가 정상이면 반복 조회하지 않는다.
  장애 시 현재 대화방에서만 12초 보완 조회한다.
  백그라운드에서 중지하고 복귀·재연결 시 누락분을 읽는다.
  동시 조회와 반복 재연결로 조회가 겹치거나 미뤄지지 않게 한다.
  최초 미확인 ID에 읽음 경계를 고정하고 최신 위치에서만 읽음 처리한다.
  보낸 말풍선의 1은 상대 read_at이 확인되면 사라진다.
  같은 알림 재진입은 초안을 유지하며 최신 메시지로 이동한다.
end note
LinkPatientCaregiverUI --> ManageCaregiverPatientLocalState
CheckCaregiverMedicationUI --> FCheckCaregiverMedication
CheckCaregiverMedicationUI *-- AsNeededScheduleSection : read-only counts / photos
CheckCaregiverMedicationUI --> MedicationHistoryUI : read-only linked history
CheckCaregiverMedicationUI --> SetCaregiverNotificationUI : PRN bell / independent subscription
SetCaregiverNotificationUI --> FSetCaregiverNotification
FSetCaregiverNotification --> BSetCaregiverNotification : authorized link settings API
BSetCaregiverNotification --> DBCaregiverNotification
CaregiverNotificationMonitorService --> CheckCaregiverMonitoring : local/demo snapshot API
CheckCaregiverMonitoring --> AsNeededEvents : today's keys, including alerts-off baseline
CaregiverNotificationMonitorService --> NotificationService : newly seen PRN identities only
note bottom of AsNeededScheduleSection
  보호자에게 복용 체크·일괄 기록·환자 확인 알림은 제공하지 않는다.
  PRN 알림은 연동별 기본 꺼짐이며 정기 시간대 설정을 상속하지 않는다.
  꺼짐 / 체크완료만 허용하고 미복약 마감 시각은 거부한다.
end note
note bottom of CaregiverNotificationMonitorService
  첫 조회와 재활성화는 기준값만 저장한다.
  이미 본 기록은 시각 정정·해제 후 재체크해도 다시 알리지 않는다.
  정기 일정 전체 완료율과 별개이며 운영 push의 대체 보장은 아니다.
end note
CheckCaregiverMedicationUI --> FSetCaregiverNotification
CheckCaregiverMedicationUI --> ManageCaregiverPatientLocalState
ManageCaregiverPatientLocalState --> CaregiverPatientLocalStateService
note bottom of ManageCaregiverPatientLocalState
  활성 연결의 서버 별칭을 기기 cache에 반영한다.
  별칭 정보가 없는 구형 연결만 cache로 보완한다.
end note

FLinkPatientCaregiver --> BLinkPatientCaregiver : link API
FCheckCaregiverMedication --> BCheckCaregiverMedication : patient status API
BLinkPatientCaregiver --> PatientCaregiverLinkRepository
BLinkPatientCaregiver --> DBPatientCaregiverLink
BLinkPatientCaregiver --> DBCaregiverNotification
note bottom of BLinkPatientCaregiver
  신규·재활성 연결은 양쪽 활성 연결 한도를 확인한다.
  연결 해제는 확인 후 알림 설정과 해당 대화를 삭제한다.
  환자의 저장 약과 복약 기록은 보존한다.
end note

